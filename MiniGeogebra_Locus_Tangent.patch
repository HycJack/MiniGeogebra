@@ -0,0 +1,28 @@
+import { IKernel } from '../core/Interfaces';
+import { GeoElement } from './GeoElement';
+import { GeoVec3D } from '../core/GeoVec3D';
+
+/**
+ * 轨迹对象（数值型）——对标 GeoGebra `Locus[Q, P]`。
