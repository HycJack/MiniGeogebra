@@ -0,0 +1,42 @@
+/**
+ * 射线构造算法 —— 两点定射线。
+ */
+
+import { IKernel } from '../core/Interfaces';
+import { AlgoElement } from './AlgoElement';
+import { GeoPoint } from '../geo/GeoPoint';
+import { GeoRay } from '../geo/GeoRay';
+import { GeoLine } from '../geo/GeoLine';
+import { GeoSegment } from '../geo/GeoSegment';
+
+export class AlgoRayTwoPoints extends AlgoElement {
+  private output: GeoRay;
+
+  constructor(kernel: IKernel, private a: GeoPoint, private b: GeoPoint) {
+    super(kernel);
+    this.output = new GeoRay(kernel, a, b);
+    this.setInputOutput();
+  }
+
+  setInputOutput(): void {
+    this.input = [this.a, this.b];
+    this.setOutput([this.output]);
+  }
+
+  getOutput(): GeoRay { return this.output; }
+
+  compute(): void {
+    if (!this.a.isDefined() || !this.b.isDefined()) {
+      this.output.setUndefined();
+      return;
+    }
+    const dx = this.b.getX() - this.a.getX();
+    const dy = this.b.getY() - this.a.getY();
+    if (Math.hypot(dx, dy) < 1e-9) {
+      this.output.setUndefined();
+      return;
+    }
+    this.output.setDefined();
+  }
+}
+

diff --git a/src/kernel/algo/AlgoRegularPolygon.ts b/src/kernel/algo/AlgoRegularPolygon.ts
